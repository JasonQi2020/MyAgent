# ---- LLM (OpenAI-compatible) ----------------------------------------------
# Provider preset: deepseek | openrouter | qwen | openai | ollama | custom
LLM_PROVIDER=deepseek

# Key: either the provider-specific variable or LLM_API_KEY (works for any provider)
DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=
# DASHSCOPE_API_KEY=
# OPENAI_API_KEY=            # also used by /strongmodel (model.strong.* in agent.properties)
# LLM_API_KEY=

# Optional overrides (otherwise the preset's defaults are used)
# LLM_MODEL=deepseek-chat
# LLM_BASE_URL=https://api.deepseek.com

# ---- Agent ------------------------------------------------------------------
DB_PATH=data/demo.db
MAX_STEPS=15
MCP_CONFIG=mcp_servers.json
# Non-secret settings such as mail.provider live in agent.properties (override the path here)
# AGENT_PROPERTIES=agent.properties

# ---- Mail secrets -------------------------------------------------------------
# Sina Mail authorization code (Settings → client POP/IMAP/SMTP → authorization code). NOT your login password.
SINA_AUTH_CODE=

# ---- IM channels (design/im_integration.md) ----------------------------------
# IM_CHANNELS=feishu            # or whatsapp, or feishu,whatsapp
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_DOMAIN=https://open.feishu.cn        # or https://open.larksuite.com for Lark
# Comma-separated open_ids allowed to use the bot. Empty = setup mode (answers nobody, logs senders).
# FEISHU_ALLOWED_USERS=
# Group chat_ids where the bot answers @mentions. Empty = direct messages only.
# FEISHU_ALLOWED_CHATS=
# IM_SESSION_IDLE_MINUTES=120
# Recent group messages given to the model with every @mention (0 = off; then only on request)
# IM_GROUP_CONTEXT_MESSAGES=15
# IM_GROUP_CONTEXT_MINUTES=30

# ---- WhatsApp (design/whatsapp_integration.md; direct messages only) ----------
# WHATSAPP_TOKEN=                  # System User token (the console's temporary token lasts 24 hours)
# WHATSAPP_PHONE_NUMBER_ID=        # WhatsApp -> API Setup
# WHATSAPP_APP_SECRET=             # App settings -> Basic; checks the webhook signature
# WHATSAPP_VERIFY_TOKEN=           # any random string; also entered in the webhook settings
# Comma-separated phone numbers allowed to use the bot. Empty = setup mode (answers nobody, logs senders).
# WHATSAPP_ALLOWED_NUMBERS=
# WHATSAPP_API_VERSION=v25.0
# HTTPS_PROXY=                     # if graph.facebook.com is not reachable directly

# ---- Claude Code (/claude) ------------------------------------------------------
# Your subscription: run `claude setup-token` and paste the token here (preferred), or an API key
# CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=

# ---- Telegram (design/telegram_integration.md) ---------------------------------
# Add "telegram" to IM_CHANNELS. Token from @BotFather (/newbot).
# TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user ids allowed to use the bot. Empty = setup mode (answers nobody, logs senders).
# TELEGRAM_ALLOWED_USERS=
# Group ids (negative numbers) always enabled; other groups via adding the bot or /enable.
# TELEGRAM_ALLOWED_CHATS=
